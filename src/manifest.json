{
  "manifest_version": 3,
  "name": "Renard",
  "version": "0.1.0",
  "description": "A pixel-art fox companion that helps you make sense of whatever you're reading. No API key needed: it can run on your computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Renard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://huggingface.co https://*.huggingface.co https://*.hf.co; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["bubble/bubble.html"],
      "matches": ["https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "shared/constants.js",
        "content/pixel.js",
        "content/markdown.js",
        "content/sprite.js",
        "content/motion.js",
        "content/keys.js",
        "content/adapters/common.js",
        "content/adapters/claude.js",
        "content/adapters/chatgpt.js",
        "content/adapters/web.js",
        "content/fox.js",
        "content/bubble.js",
        "content/app.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-bubble": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open or close Renard's question bubble"
    },
    "toggle-visibility": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Hide or show Renard"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "renard-companion@YeziShanYang",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "personalCommunications"]
      }
    }
  }
}
