{
  "name": "renard-companion",
  "version": "0.1.3",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Pixel-art fox companion for reading and summarizing web pages, with a built-in model or your own API key.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start": "web-ext run --source-dir src --start-url https://claude.ai/new",
    "build:chrome": "node scripts/package.mjs --target chrome --no-zip",
    "start:chrome": "npm run build:chrome && web-ext run --source-dir dist/chrome --target chromium --start-url https://claude.ai/new",
    "lint": "web-ext lint --source-dir src",
    "build": "node scripts/package.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:firefox": "node test/e2e/firefox-install.mjs"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@huggingface/transformers": "4.3.2",
    "katex": "0.19.1",
    "web-ext": "10.8.0"
  }
}
